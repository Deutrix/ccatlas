{
  "name": "ccatlas",
  "version": "0.5.1",
  "description": "Inventory, freshness, usage and portability for your Claude Code extensions",
  "license": "MIT",
  "author": "Deutrix",
  "type": "module",
  "bin": {
    "ccatlas": "bin/ccatlas"
  },
  "files": [
    "bin/",
    ".claude-plugin/",
    "skills/",
    "commands/",
    "hooks/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.mjs\"",
    "leak-scan": "node scripts/leak-scan.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "validate-plugin": "claude plugin validate dist/plugin --strict",
    "sync-version": "node scripts/sync-version.mjs",
    "token-budget": "node --experimental-strip-types scripts/token-budget.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "claude-code",
    "inventory",
    "plugins",
    "mcp",
    "skills",
    "audit"
  ]
}
